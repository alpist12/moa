rules_version = '2';
// Each signed-in user can read/write only their own document: users/{uid}
// Paste into Firebase console > Firestore Database > Rules (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['store', 'goals', 'updatedAt'])
        && request.resource.data.store is string
        && request.resource.data.goals is string;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
